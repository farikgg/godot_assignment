; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dungeon Delver"
run/main_scene="uid://kya2x2ycmcrp"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Roster="*res://scripts/roster.gd"
Profile="*uid://yslerpjvmluu"
GameFlow="*res://scripts/game_flow.gd"
MusicPlayer="*res://scripts/music_player.gd"
UiSounds="*res://scripts/ui/ui_sounds.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://assets/Audio/": "yellow",
"res://assets/UI/": "red",
"res://scenes/": "orange",
"res://scripts/": "pink"
}

[gui]

theme/custom="res://assets/ui_gen/ui_theme.tres"
theme/custom_font="res://assets/fonts/Rubik-Bold.ttf"

