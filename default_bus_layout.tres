[gd_resource type="AudioBusLayout" load_steps=3 format=3]

[sub_resource type="AudioEffectLowPassFilter" id="AudioEffectLowPassFilter_paused"]
resource_name = "Paused LowPass"
cutoff_hz = 20000.0

[sub_resource type="AudioEffectAmplify" id="AudioEffectAmplify_paused"]
resource_name = "Paused Amplify"

[resource]
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = -10.0
bus/1/send = &"Master"
bus/1/effect/0/effect = SubResource("AudioEffectLowPassFilter_paused")
bus/1/effect/0/enabled = false
bus/1/effect/1/effect = SubResource("AudioEffectAmplify_paused")
bus/1/effect/1/enabled = false
bus/2/name = &"SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
