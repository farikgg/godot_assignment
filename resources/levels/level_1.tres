[gd_resource type="Resource" script_class="LevelData" format=3]

[ext_resource type="Script" path="res://scripts/data/level_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/enemy_spawn.gd" id="2_spawn"]
[ext_resource type="PackedScene" path="res://scenes/enemies/minion.tscn" id="r1"]
[ext_resource type="Resource" path="res://resources/enemies/guard.tres" id="r2"]
[ext_resource type="PackedScene" path="res://scenes/enemies/shooter.tscn" id="r3"]
[ext_resource type="Resource" path="res://resources/enemies/shooter_short.tres" id="r4"]
[ext_resource type="PackedScene" path="res://scenes/enemies/charger.tscn" id="r5"]
[ext_resource type="Resource" path="res://resources/enemies/charger.tres" id="r6"]

[sub_resource type="Resource" id="minion"]
script = ExtResource("2_spawn")
scene = ExtResource("r1")
data = ExtResource("r2")
marker = &"MinionStart"
patrol_offset = Vector3(4, 0, 0)
start_yaw_degrees = 90.0

[sub_resource type="Resource" id="shooter"]
script = ExtResource("2_spawn")
scene = ExtResource("r3")
data = ExtResource("r4")
marker = &"ShooterStart"
start_yaw_degrees = 90.0

[sub_resource type="Resource" id="charger"]
script = ExtResource("2_spawn")
scene = ExtResource("r5")
data = ExtResource("r6")
marker = &"ChargerStart"

[resource]
script = ExtResource("1_script")
id = &"level_1"
title = "Уровень 1 — Верхние залы"
scene_path = "res://scenes/levels/level_1.tscn"
unlocked_by_default = true
next_level_id = &"level_2"
par_time_sec = 120.0
goal = 0
coins_required = 5
enemy_spawns = Array[ExtResource("2_spawn")]([SubResource("minion"), SubResource("shooter"), SubResource("charger")])
